#!/bin/zsh

TODO_FILE=${TODO_FILE:-$HOME/TODO_FILE}

list() {
    test -f $TODO_FILE && nl $TODO_FILE
}

append() {
    echo "$*" >> $TODO_FILE
}

delete() {
    test -n "$1" || exit 1
    sed -i -e "${1}d" $TODO_FILE
}

test "$1" = '-d' && delete "$2" && exit 0

test -n "$*" && append $* || list

exit 0

